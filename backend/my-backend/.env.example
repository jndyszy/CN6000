# ── JWT ─────────────────────────────────────────────────────────
# 生产环境必须替换为随机长字符串（建议 64 字符以上）
JWT_SECRET=change-me-to-a-random-secret

# ── Gmail SMTP（密码重置 OTP）────────────────────────────────────
# 使用 Google 账号的「应用专用密码」，不是登录密码
GMAIL_FROM=your-address@gmail.com
GMAIL_PASSWORD=your-16-char-app-password

# ── 图片上传 ──────────────────────────────────────────────────────
# 容器内路径，与 docker-compose volumes 挂载点一致
UPLOAD_DIR=./uploads

# 对外暴露的域名或 IP，用于拼接图片访问 URL
BASE_URL=http://localhost:8080

# ── 数据库 / Redis ────────────────────────────────────────────────
# docker-compose 已通过 environment 字段注入，本地开发时才需要在此设置
# DATABASE_URL=host=127.0.0.1 user=admin password=admin dbname=postgres port=5432 sslmode=disable TimeZone=UTC
# REDIS_ADDR=localhost:6379
